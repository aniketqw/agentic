"""Independent references: Fraction/Decimal, finite differences, NumPy direct GEMM,
format bit formulas, deterministic distribution mass conservation. CPU only."""
import json,math
from pathlib import Path
from fractions import Fraction
from decimal import Decimal,getcontext
import numpy as np
import math_companion as m
getcontext().prec=60
checks=[]
def check(cid,actual,expected,method,atol=1e-9):
 ok=bool(np.allclose(actual,expected,rtol=1e-8,atol=atol));checks.append({'check_id':cid,'method':method,'status':'passed' if ok else 'failed','actual':np.asarray(actual).tolist(),'expected':np.asarray(expected).tolist()})
for depth in (1,2,3):
 a=m.mtp_alignment(list(range(6)),depth)
 check('MTP-align-'+str(depth),[[x['base'],x['conditioning'],x['target']] for x in a],[[i,i+depth,i+depth+1] for i in range(5-depth)],'independent explicit index triples')
check('MTP-no-target-leakage',all(t['conditioning']<t['target'] for d in (1,2,3) for t in m.mtp_alignment(list(range(6)),d)),True,'conditioning-before-target invariant')
check('MTP-count',sum(len(m.mtp_alignment(range(10),d)) for d in (1,2,3)),21,'8+7+6 finite sequence convention')
check('MTP-rmsnorm',m.rmsnorm([3,4],eps=0),[3/math.sqrt(12.5),4/math.sqrt(12.5)],'analytic RMS')
check('MTP-projection-params',2*512**2,524288,'integer arithmetic')
check('MTP-shared-head',120000*5120,614400000,'integer arithmetic')
check('MTP-loss',.6+.1/3*(.4+.8+1),float(Decimal('0.6')+Decimal('0.1')/3*Decimal('2.2')),'60-digit Decimal')
p=np.array([.8,.6]);h=1e-5;fd=np.array([(m.chain_loss(p+np.eye(2)[j]*h)-m.chain_loss(p-np.eye(2)[j]*h))/(2*h) for j in range(2)])
check('MTP-chain-gradient',m.chain_grad(p),fd,'central finite differences of scalar objective')
s=m.speculative([.6,.3,.1],[.2,.5,.3]);check('SPEC-accept',s['acceptance'],[1,.6,1/3],'exact rational ratios');check('SPEC-residual',s['residual'],[1,0,0],'positive residual masses');check('SPEC-law',s['output'],[.6,.3,.1],'accepted+rejected output mass')
check('SPEC-rate',1-s['rejection'],.6,'sum min(p,q)')
check('SPEC-q-zero',m.speculative([.7,.3],[1,0])['output'],[.7,.3],'target support absent in draft still recovered by residual')
check('SPEC-equal',m.speculative([.6,.4],[.6,.4])['output'],[.6,.4],'all accepted; no residual required')
check('SPEC-expected-count',sum(.8**j for j in range(5)),3.3616,'geometric expected output for 4 drafts plus correction/bonus')
check('FP8-E4max',max(v for v,c in m.fp8_values()),448,'1.75 * 2^8 encoding 0x7e')
check('FP8-E4min',min(v for v,c in m.fp8_values() if v),2**-9,'subnormal exponent formula')
check('FP8-E5max',max(v for v,c in m.fp8_values('e5m2')),57344,'1.75 * 2^15 encoding 0x7b')
check('FP8-E5min',min(v for v,c in m.fp8_values('e5m2') if v),2**-16,'subnormal exponent formula')
check('FP8-tie-even',m.cast_fp8(1.0625),1.,'midpoint between 1 and 1.125, even lower code');check('FP8-tie-odd',m.cast_fp8(1.1875),1.25,'midpoint odd lower code chooses even upper');check('FP8-saturation',m.cast_fp8(500),448,'declared saturating conversion')
check('FP8-subnormal-tie',m.cast_fp8(2**-10),0.,'half smallest subnormal rounds to even zero')
q=m.quantize([1,2,-4]);check('FP8-scale',q['scale'],112.,'448/4');check('FP8-codes',q['q'],[112,224,-448],'exact encodable powers');check('FP8-reconstruct',q['reconstructed'],[1,2,-4],'quantize-dequantize identity for encodable fixture')
check('FP8-zero-tensor',m.quantize([0,0])['reconstructed'],[0,0],'zero amax branch')
check('FP8-delayed-clip',m.quantize([8],amax=4)['reconstructed'],[4],'stale amax clips scaled 896 to 448');check('FP8-online-clip',m.quantize([8])['reconstructed'],[8],'fresh amax avoids clipping')
check('FP8-weight-scales',math.ceil(4096/128)**2,1024,'ceil row blocks times ceil column blocks');check('FP8-act-scales',4*10*math.ceil(4096/128),1280,'per token per group')
check('FP8-scale-overhead',1024*4/(4096**2),1/4096,'FP32 scale bytes divided by FP8 payload bytes');check('FP8-memory-70B',70000000000*np.array([4,2,1]),[280000000000,140000000000,70000000000],'raw payload decimal byte counts')
check('FP8-storage-state',1e9*(4+4+2+2),12e9,'FP32 master+gradient, BF16 first+second moments; excludes model cache')
x=np.array([[1,2],[3,4]],float);w=np.array([[.5,-1],[2,.25]],float);dy=np.array([[1,2],[-1,.5]])
dx,dw=m.linear_backward(x,w,dy)
check('LINEAR-fprop',x@w,[[4.5,-.5],[9.5,-2]],'independent hand dot products')
check('LINEAR-dgrad',dx,[[-1.5,2.5],[-1, -1.875]],'hand sums dY W^T')
check('LINEAR-wgrad',dw,[[-2,3.5],[-2,6]],'hand sums X^T dY')
check('LINEAR-update',w-.1*dw,[[.7,-1.35],[2.2,-.35]],'SGD parameter subtraction')
for j in range(4):
 perturb=np.zeros_like(w);perturb.flat[j]=1e-6
 fd=((x@(w+perturb)*dy).sum()-(x@(w-perturb)*dy).sum())/2e-6
 check('LINEAR-gradient-'+str(j),dw.flat[j],fd,'central differences <XW,dY>',atol=1e-7)
check('FP8-block-gemm',m.block_linear([[1,2],[3,4]],[[1,0],[0,1]],block=1),[[1,2],[3,4]],'identity fixture each channel has its own scale')
check('FP8-partial-groups',m.block_linear([[1,2,3]],[[1],[2],[3]],block=1),[[14]],'unequal scales dequantized inside reduction')
check('ACCUM-naive-fp32',float(np.float32(np.float32(1e8)+np.float32(1))-np.float32(1e8)),0,'explicit float32 cancellation')
check('ACCUM-high-precision',math.fsum([1e8,1,-1e8]),1,'compensated double reference; illustrates irrecoverable partial-sum error')
check('ACCUM-chunks',math.ceil(16384/128),128,'integer chunk count')
check('DP-effective-batch',16*4*8,512,'microbatch*replica*accumulation')
check('DP-average',m.weighted_gradient([1,3,5,7],[16]*4),4,'equal sample average')
check('DP-unequal',m.weighted_gradient([2,8],[2,1]),4,'weighted objective 2/3*2+1/3*8')
check('DP-not-unweighted',np.mean([2,8]),5,'demonstrate bias from unequal mean averaging')
check('DP-token-batch',16*4*8*2048,1048576,'effective sequence batch times length')
check('DP-ring-bytes',2*(8-1)/8*4e9,7e9,'ring all-reduce per-rank send-volume simplified')
for p,b in [(4,8),(4,32),(16,128),(16,512)]:
 z=m.pipeline(p,b);check('PIPE-eff-'+str(p)+'-'+str(b),z['efficiency'],float(Fraction(b,b+p-1)),'Fraction balanced schedule reference')
c=m.communication(1000,2,4096,2,.75)
check('MOE-assignments',c['assignments'],2000,'token count times top-k');check('MOE-gross',c['gross_one_way_bytes'],16384000,'integer byte arithmetic');check('MOE-remote',c['remote_one_way_bytes'],12288000,'75% remote assumption');check('MOE-dispatch-combine',c['dispatch_plus_combine_bytes'],24576000,'same dtype and width in both directions assumption')
check('MOE-expert-load',1000*2/8,250,'uniform top-k assignments per expert')
check('DUAL-overlap',max(8,6),8,'ideal independent compute/network overlap lower bound');check('DUAL-speedup',14/max(8,6),1.75,'serial/ideal overlap ratio');check('DUAL-fold-ranks',8//2,4,'two equal-sized stages per physical rank')
check('DUAL-bubble-example',(8/2-1)*(3+2-3*.5),10.5,'official formula with F&B=3 B=2 W=.5; positive valid hypothetical values')

check('MTP-CE-exact',math.log(sum(math.exp(z) for z in [2,1,.5,-1]))-1,1.495181898085856,'independent log-sum-exp reference')
check('MTP-scalar-route',2*.5*.8*.6,.48,'chain multiplication')
check('MTP-scalar-weighted',1.2+.1*(.5+.4+.48),1.338,'alpha=.1 per loss; alpha=lambda/D')
check('MTP-projection-256',2*256*256,131072,'two normalized d vectors projected to d')
check('MTP-decay',.5**5,.03125,'Jacobian product illustration')
check('MTP-shapes-S32',32-2-1,29,'depth2 plus main NTP target shift')
check('MTP-shapes-S12',np.array([12-k-1 for k in [1,2,3]]),[10,9,8],'finite complete sequence corrections')
check('FP8-INT8-outlier',np.rint(np.array([2,3,500])*127/500),[1,1,127],'independent INT8 toy explicitly not E4M3')
check('FP8-INT8-recon',1/(127/500),float(Fraction(500,127)),'Fraction exact inverse scale')
check('FP8-group7168',7168//128,56,'divisible activation width')
check('FP8-weight512',math.ceil(512/128)**2,16,'square weight block count')
check('FP8-activation-memory',32*4096*4096*4,2147483648,'FP32 tensor bytes =2 GiB')
check('ACCUM-4096',4096//128,32,'reduction chunk count, each chunk four WGMMAs in paper')
check('ACCUM-8192',8192//128,64,'reduction chunk count')
check('ACCUM-remainder',np.array([math.ceil(1000/128),1000-7*128]),[8,104],'ceil chunks and final remainder')
check('ACCUM-partial-sum',float(sum(Decimal(a) for a in ['12.345','7.891','-3.217','.004'])),17.023,'60-digit Decimal partial sums')
check('FP8-field-patterns',[2**4,2**3,2**5,2**2],[16,8,32,4],'raw bit-pattern counts, not distinct finite totals')
check('FP8-mantissa-percentage',100*(3-2)/8,12.5,'percentage point difference')
check('ONLINE-INT8-small',[round(.1*127/50),round(.1*127/2)],[0,6],'explicit INT8 historical/current calibration toy')
check('ONLINE-INT8-overflow',50*127/2,3175,'preclipping code outside +/-127 range')
check('PIPE-exam-8-32',m.pipeline(8,32)['efficiency'],float(Fraction(32,39)),'Fraction schedule utilization')
check('PIPE-exam-8-64',m.pipeline(8,64)['efficiency'],float(Fraction(64,71)),'Fraction schedule utilization')
check('DP-exam-batch',4*8*4,128,'sequences per synchronized update')
check('DP-exam-tokens',128*2048,262144,'tokens per update excluding masked tokens')
check('MOE-exam-route',4096*4/32,512,'ideal assignments per expert')
check('MOE-exam-volume',4096*2*2048*2,33554432,'gross one direction payload =32 MiB')
check('MOE-large-volume',65536*8*4096*2,4294967296,'gross payload =4 GiB, not4GB')
check('DUAL-exam-fold',24//2,12,'two stages per rank')
check('DUAL-exam-speedup',24/15,1.6,'ideal 15ms compute and9ms independent communication')
out={'passed':sum(c['status']=='passed' for c in checks),'failed':sum(c['status']=='failed' for c in checks),'checks':checks,'scope':'CPU deterministic educational fixtures; no actual Transformer MTP training, hardware FP8 GEMM, distributed collective or DualPipe profiling executed.'}
Path(__file__).with_name('evidence.json').write_text(json.dumps(out,indent=2));print(json.dumps({k:out[k] for k in ('passed','failed','scope')}))
if out['failed']:raise SystemExit(1)
